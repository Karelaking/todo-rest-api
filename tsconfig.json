{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "paths": {
      "@/*": ["./src/*"],},
  "outDir": "dist",
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
